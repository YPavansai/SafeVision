# SafeVision Environment Configuration Example
# Copy this file to .env and replace all placeholder values before running in production.

# Environment Mode: development | production
DJANGO_ENV=development
DEBUG=True

# Generate a strong random secret key in production (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-with-strong-random-secret-key

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed CORS and CSRF origins for production frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (set SECURE_SSL_REDIRECT=True when serving over HTTPS in production)
SECURE_SSL_REDIRECT=False

# Database: either DATABASE_URL (PostgreSQL/MySQL) OR MYSQL_* variables
# DATABASE_URL=postgres://user:password@host:5432/safevision
MYSQL_DATABASE=safevision
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-db-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# JWT Lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Rate Limiting
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_AI=60/min

# AI & Concurrency Tuning (tuned for 16GB RAM / NVIDIA MX550 2GB VRAM)
AI_MAX_CONCURRENT_INFERENCE=2
AI_INFERENCE_TIMEOUT=30
AI_IMAGE_SIZE=480
AI_MAX_IMAGE_DIM=1280
TORCH_NUM_THREADS=2

# Optional Redis / Celery (leave empty to use built-in bounded ThreadPool job runner)
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# USE_CELERY=False
